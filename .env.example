# Copy to .env.local and fill in what you need. Everything is optional for a local run:
# without it the site falls back to public endpoints and skips the features below.

# Chain RPC (defaults to the public Robinhood Chain testnet RPC)
EXIT_RPC_URL=

# Redis (Upstash / Vercel KV) for shared caches, points and rate limits
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server secrets (any long random string)
RUN_SECRET=
VIP_SECRET=

# Privy sign-in (https://dashboard.privy.io); leave empty to use injected wallets only
NEXT_PUBLIC_PRIVY_APP_ID=

# $EXIT line (token + creator on vibe/vibe); DEMO_TOKEN replays another token before launch
NEXT_PUBLIC_EXIT_TOKEN=
NEXT_PUBLIC_EXIT_CREATOR=
NEXT_PUBLIC_DEMO_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_X_HANDLE=exitliqfun
NEXT_PUBLIC_X_LIVE=

# Optional: path to the Early Index JSON (defaults to src/data/early-index.json)
EARLY_INDEX_PATH=
STATE_VIBE_API=
